# HV kit — cache rules for every Home Vacation system (copied by hv-shared/kit/sync.sh; CRM keeps its own _headers
# with the same rules added to its security headers).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/hv-core.js
  Cache-Control: no-cache
/hv-tour.js
  Cache-Control: no-cache
/hv-ping.txt
  Cache-Control: no-store
  Access-Control-Allow-Origin: *
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
